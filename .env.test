# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Les tests d'integration parlent a une base reelle, distincte de celle de
# developpement : c'est la seule facon d'attraper ce qu'un mock ne voit pas
# (conversion des types Doctrine, contraintes SQL, comportement du pilote).
# Le nom porte la base de développement, pas « mssub_test » : Doctrine ajoute
# lui-même le suffixe _test en environnement de test (voir when@test dans
# config/packages/doctrine.yaml). L'écrire ici donnerait « mssub_test_test »,
# ce qui ne se voit pas tant que la variable d'environnement de Docker Compose
# masque ce fichier — mais casse dès qu'on lance les tests autrement.
DATABASE_URL="mysql://mssub:mssub@db:3306/mssub?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
