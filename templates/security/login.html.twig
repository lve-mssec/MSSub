<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connexion — MSSub</title>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
</head>
<body>
<div class="login">
    <div class="login__box">
        <div class="login__brand">
            <span class="sidebar__mark"></span>
            <span>MSSub</span>
        </div>

        {% for message in app.flashes('error') %}
            <div class="alert">{{ message }}</div>
        {% endfor %}

        {% if error %}
            <div class="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" class="card">
            <div class="login__field">
                <label for="username">Identifiant</label>
                <input type="text" id="username" name="username" value="{{ last_username }}"
                       autocomplete="username" autofocus required>
            </div>

            <div class="login__field">
                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="password" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="login__actions">
                <button class="btn" type="submit">Se connecter</button>
            </div>
        </form>

        {% if oidc_enabled %}
            <div class="login__sso">
                <span class="login__separator">ou</span>
                <a class="btn btn--quiet" href="{{ path('app_oidc_start') }}">
                    Se connecter avec {{ oidc_label }}
                </a>
            </div>
        {% endif %}

        <p class="login__hint">
            {% if ldap_enabled %}
                Comptes locaux et comptes d'annuaire acceptés sur le même formulaire.
            {% else %}
                Authentification locale.
            {% endif %}
        </p>
    </div>
</div>
</body>
</html>
