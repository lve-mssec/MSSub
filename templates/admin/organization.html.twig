{% extends 'base.html.twig' %}

{% block title %}Organisations — MSSub{% endblock %}

{% block body %}
    <p class="breadcrumb"><a href="{{ path('app_admin') }}">Administration</a> <span>›</span> Organisations</p>

    <div class="page-head page-head--with-action">
        <div>
            <h1>Organisations</h1>
            <p>Le plus haut niveau du référentiel : chacune porte son propre plan d'adressage.</p>
        </div>
        <a class="btn no-print" href="{{ path('app_admin_organization_new') }}">Nouvelle organisation</a>
    </div>

    {% if rows is empty %}
        <div class="note">Aucune organisation déclarée.</div>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead><tr><th>Code</th><th>Nom</th><th>Sites</th><th>Réseaux</th><th>Description</th><th class="no-print"></th></tr></thead>
                <tbody>
                {% for row in rows %}
                    <tr>
                        <td><code class="inline">{{ row.organization.code }}</code></td>
                        <td>{{ row.organization.name }}</td>
                        <td class="muted">{{ row.sites }}</td>
                        <td class="muted">{{ row.subnets }}</td>
                        <td class="reason">{{ row.organization.description ?? '—' }}</td>
                        <td class="row-actions no-print">
                            <a href="{{ path('app_admin_organization_edit', {id: row.organization.id}) }}">Modifier</a>
                            <form method="post" action="{{ path('app_admin_organization_delete', {id: row.organization.id}) }}"
                                  onsubmit="return confirm('Supprimer {{ row.organization.name }} ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer-organisation-' ~ row.organization.id) }}">
                                <button type="submit">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
