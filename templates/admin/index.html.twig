{% extends 'base.html.twig' %}

{% block title %}Administration — MSSub{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Administration</h1>
        <p>Référentiel et paramètres d'exploitation.</p>
    </div>

    <h2 class="section">Référentiel</h2>
    <div class="grid grid--stats">
        {% for card in [
            {label: 'Organisations', value: counts.organizations, route: 'app_admin_organization'},
            {label: 'Sites', value: counts.sites, route: 'app_admin_site'},
            {label: 'VLAN', value: counts.vlans, route: 'app_admin_vlan'},
            {label: 'Équipements', value: counts.devices, route: 'app_admin_device'},
            {label: 'Comptes', value: counts.users, route: 'app_admin_user'}
        ] %}
            <a class="card card--link" href="{{ path(card.route) }}">
                <div class="stat__value">{{ card.value }}</div>
                <div class="stat__label">{{ card.label }}</div>
            </a>
        {% endfor %}
    </div>

    <h2 class="section">Authentification</h2>
    <div class="grid grid--two">
        <a class="card card--link" href="{{ path('app_admin_ldap') }}">
            <h3 class="card__title">Annuaire LDAP / Active Directory
                <span class="pill pill--{{ ldap ? 'used' : 'free' }}">{{ ldap ? 'actif' : 'inactif' }}</span>
            </h3>
            <p class="muted">Serveur, compte de service, attribut d'identifiant. Test de connexion inclus.</p>
        </a>

        <a class="card card--link" href="{{ path('app_admin_oidc') }}">
            <h3 class="card__title">Fournisseur d'identité (OIDC)
                <span class="pill pill--{{ oidc ? 'used' : 'free' }}">{{ oidc ? 'actif' : 'inactif' }}</span>
            </h3>
            <p class="muted">Points d'entrée, identifiant et secret client, revendications.</p>
        </a>

        <a class="card card--link" href="{{ path('app_admin_roles') }}">
            <h3 class="card__title">Correspondance des rôles</h3>
            <p class="muted">Quels groupes d'annuaire ou du SSO donnent quels droits dans MSSub.</p>
        </a>
    </div>
{% endblock %}
