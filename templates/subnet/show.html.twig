{% extends 'base.html.twig' %}

{% block title %}{{ subnet.cidr }} — MSSub{% endblock %}

{% block body %}
    <p class="breadcrumb">
        <a href="{{ path('app_subnet_index') }}">Plans d'adressage</a>
        <span>›</span>
        {{ subnet.organization.name }}
        {% for ancestor in ancestors %}
            <span>›</span>
            <a href="{{ path('app_subnet_show', {id: ancestor.id}) }}">{{ ancestor.cidr }}</a>
        {% endfor %}
    </p>

    <div class="page-head page-head--with-action">
        <div>
            <h1>{{ subnet.cidr }}</h1>
            <p>{{ subnet.name ?? 'Sans nom' }}{% if subnet.description %} — {{ subnet.description }}{% endif %}</p>
        </div>
        {% if is_granted('ROLE_OPERATOR') %}
            <div class="page-head__actions no-print">
                <a class="btn btn--quiet" href="{{ path('app_subnet_edit', {id: subnet.id}) }}">Modifier</a>
                {% if not subnet.container %}
                    <a class="btn" href="{{ path('app_address_new', {id: subnet.id}) }}">Ajouter une adresse</a>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <form method="post" action="{{ path('app_subnet_delete', {id: subnet.id}) }}"
                          onsubmit="return confirm('Supprimer {{ subnet.cidr }} ? Les sous-réseaux seront rattachés au bloc parent.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer-reseau-' ~ subnet.id) }}">
                        <button class="btn btn--quiet btn--danger" type="submit">Supprimer</button>
                    </form>
                {% endif %}
            </div>
        {% endif %}
    </div>

    <div class="grid grid--two">
        <div class="card">
            <h2 class="section" style="margin-top:0">Caractéristiques</h2>
            <table>
                <tbody>
                <tr><th>État</th><td>{{ subnet.status.label }}</td></tr>
                <tr><th>Version</th><td>{{ subnet.version.label }}</td></tr>
                <tr><th>Plage</th><td class="cidr">{{ subnet.networkAddress }} → {{ subnet.lastAddress }}</td></tr>
                <tr><th>Site</th><td>{{ subnet.site ? subnet.site.name : '—' }}</td></tr>
                <tr><th>VLAN</th><td>{{ subnet.vlan ? subnet.vlan : '—' }}</td></tr>
                <tr><th>Passerelle</th><td class="cidr">{{ subnet.gateway ?? '—' }}</td></tr>
                <tr><th>DNS</th><td class="cidr">{{ subnet.dnsServers ? subnet.dnsServers|join(', ') : '—' }}</td></tr>
                <tr>
                    <th>DHCP</th>
                    <td>
                        {% if subnet.dhcpEnabled %}
                            <span class="cidr">{{ subnet.dhcpRangeStart }} → {{ subnet.dhcpRangeEnd }}</span>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                </tr>
                </tbody>
            </table>
        </div>

        <div class="card">
            <h2 class="section" style="margin-top:0">Occupation</h2>
            {% if usage %}
                <div class="stat__value">{{ usage.percent }} %</div>
                <div class="stat__label">{{ usage.used }} adresse{{ usage.used > 1 ? 's' }} sur {{ usage.usable }} attribuables</div>
                <div class="gauge" style="margin-top:12px">
                    <div class="gauge__fill" style="width: {{ min(usage.percent, 100) }}%"></div>
                </div>

                <h2 class="section">Prochaines adresses libres</h2>
                {% if freeAddresses is empty %}
                    <div class="note">Ce réseau est plein.</div>
                {% else %}
                    <p class="cidr">{{ freeAddresses|join(', ') }}</p>
                    {% if is_granted('ROLE_OPERATOR') %}
                        <form method="post" action="{{ path('app_address_reserve', {id: subnet.id}) }}" class="no-print">
                            <input type="hidden" name="_token" value="{{ csrf_token('reserver-' ~ subnet.id) }}">
                            <button class="btn btn--quiet btn--small" type="submit">
                                Réserver {{ freeAddresses|first }}
                            </button>
                        </form>
                    {% endif %}
                {% endif %}
            {% else %}
                <div class="note">
                    Ce bloc est un conteneur : il accueille des sous-réseaux, pas des adresses.
                </div>

                {% if freeBlocks is not empty %}
                    <h2 class="section">Prochains emplacements libres</h2>
                    <table>
                        <tbody>
                        {% for suggestion in freeBlocks %}
                            <tr>
                                <th>/{{ suggestion.prefix }}</th>
                                <td class="cidr">{{ suggestion.cidr }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            {% endif %}
        </div>
    </div>

    {% if children is not empty %}
        <h2 class="section">Sous-réseaux</h2>
        <div class="table-wrap">
            <table>
                <thead>
                <tr><th>Réseau</th><th>Nom</th><th>État</th><th>VLAN</th><th>Site</th></tr>
                </thead>
                <tbody>
                {% for child in children %}
                    <tr>
                        <td class="cidr"><a href="{{ path('app_subnet_show', {id: child.id}) }}">{{ child.cidr }}</a></td>
                        <td class="reason">{{ child.name ?? '—' }}</td>
                        <td><span class="pill pill--{{ child.status.value == 'container' ? 'container' : 'used' }}">{{ child.status.label }}</span></td>
                        <td>{{ child.vlan ? child.vlan.number : '—' }}</td>
                        <td>{{ child.site ? child.site.name : '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if not subnet.container %}
        <h2 class="section">Adresses documentées</h2>
        {% if addresses is empty %}
            <div class="note">Aucune adresse documentée dans ce réseau.</div>
        {% else %}
            <div class="table-wrap">
                <table>
                    <thead>
                    <tr><th>Adresse</th><th>État</th><th>Nom d'hôte</th><th>MAC</th><th>Interface</th><th>Description</th>{% if is_granted('ROLE_OPERATOR') %}<th class="no-print"></th>{% endif %}</tr>
                    </thead>
                    <tbody>
                    {% for address in addresses %}
                        <tr>
                            <td class="cidr">{{ address.address }}</td>
                            <td>
                                <span class="pill pill--{{ {
                                    'used': 'used', 'free': 'free', 'reserved': 'reserved',
                                    'dhcp': 'dhcp', 'gateway': 'gateway', 'not_applicable': 'na'
                                }[address.status.value] }}">{{ address.status.label }}</span>
                            </td>
                            <td>{{ address.hostname ?? '—' }}</td>
                            <td class="cidr muted">{{ address.macAddress ?? '—' }}</td>
                            <td>{{ address.interface ? address.interface : '—' }}</td>
                            <td class="reason">{{ address.description ?? '—' }}</td>
                            {% if is_granted('ROLE_OPERATOR') %}
                                <td class="row-actions no-print">
                                    <a href="{{ path('app_address_edit', {id: address.id}) }}">Modifier</a>
                                    <form method="post" action="{{ path('app_address_delete', {id: address.id}) }}"
                                          onsubmit="return confirm('Supprimer {{ address.address }} ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer-adresse-' ~ address.id) }}">
                                        <button type="submit">Supprimer</button>
                                    </form>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
