{% extends 'base.html.twig' %}

{% block title %}Plans d'adressage — MSSub{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Plans d'adressage</h1>
        <p>Hiérarchie des blocs et des sous-réseaux, par organisation.</p>
    </div>

    {% for entry in trees %}
        <div class="section-head">
            <h2 class="section">{{ entry.organization.name }}</h2>
            {% if entry.rows is not empty %}
                <div class="section-head__actions no-print">
                    <button type="button" class="btn btn--quiet btn--small" data-tree-all="expand">Tout déplier</button>
                    <button type="button" class="btn btn--quiet btn--small" data-tree-all="collapse">Tout plier</button>
                </div>
            {% endif %}
        </div>

        {% if entry.rows is empty %}
            <div class="note">Aucun bloc déclaré pour cette organisation.</div>
        {% else %}
            <div class="table-wrap">
                <table class="tree-table" data-tree>
                    <thead>
                    <tr>
                        <th>Réseau</th>
                        <th>Nom</th>
                        <th>État</th>
                        <th>VLAN</th>
                        <th>Site</th>
                        <th class="col-usage">Occupation</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in entry.rows %}
                        <tr data-id="{{ row.subnet.id }}"
                            data-parent="{{ row.parentId ?? '' }}"
                            data-depth="{{ row.depth }}">
                            <td class="cidr">
                                <span class="tree-cell" style="padding-left: {{ row.depth * 18 }}px">
                                    {% if row.hasChildren %}
                                        <button type="button" class="tree-toggle no-print"
                                                aria-expanded="true"
                                                aria-label="Plier ou déplier {{ row.subnet.cidr }}">▾</button>
                                    {% else %}
                                        <span class="tree-toggle tree-toggle--leaf" aria-hidden="true"></span>
                                    {% endif %}
                                    <a href="{{ path('app_subnet_show', {id: row.subnet.id}) }}">{{ row.subnet.cidr }}</a>
                                </span>
                            </td>
                            <td class="reason">{{ row.subnet.name ?? '—' }}</td>
                            <td>
                                <span class="pill pill--{{ row.subnet.status.value == 'container' ? 'container' : (row.subnet.status.value == 'reserved' ? 'reserved' : 'used') }}">
                                    {{ row.subnet.status.label }}
                                </span>
                            </td>
                            <td class="muted">{{ row.subnet.vlan ? row.subnet.vlan.number : '—' }}</td>
                            <td class="muted">{{ row.subnet.site ? row.subnet.site.name : '—' }}</td>
                            <td class="col-usage">
                                {% if row.usage %}
                                    <div class="usage">
                                        <div class="gauge">
                                            <div class="gauge__fill" style="width: {{ min(row.usage.percent, 100) }}%"></div>
                                        </div>
                                        <span class="usage__text">{{ row.usage.used }}/{{ row.usage.usable }}</span>
                                    </div>
                                {% else %}
                                    <span class="muted">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% else %}
        <div class="note">Aucune organisation déclarée.</div>
    {% endfor %}

    <script src="{{ asset('tree.js') }}" defer></script>
{% endblock %}
