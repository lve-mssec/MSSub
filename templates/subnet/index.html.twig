{% extends 'base.html.twig' %}

{% block title %}Plans d'adressage — MSSub{% endblock %}

{% macro branch(node) %}
    {% import _self as tree %}
    <li>
        <div class="tree__row">
            <span class="cidr"><a href="{{ path('app_subnet_show', {id: node.subnet.id}) }}">{{ node.subnet.cidr }}</a></span>
            <span class="tree__name">{{ node.subnet.name ?? '—' }}</span>
            {% if node.subnet.status.value == 'container' %}
                <span class="pill pill--container">{{ node.subnet.status.label }}</span>
            {% endif %}
            {% if node.subnet.vlan %}
                <span class="tree__meta">VLAN {{ node.subnet.vlan.number }}</span>
            {% endif %}
            {% if node.subnet.site %}
                <span class="tree__meta">{{ node.subnet.site.name }}</span>
            {% endif %}
        </div>
        {% if node.children is not empty %}
            <ul>
                {% for child in node.children %}
                    {{ tree.branch(child) }}
                {% endfor %}
            </ul>
        {% endif %}
    </li>
{% endmacro %}

{% block body %}
    {% import _self as tree %}

    <div class="page-head">
        <h1>Plans d'adressage</h1>
        <p>Hiérarchie des blocs et des sous-réseaux, par organisation.</p>
    </div>

    {% for entry in trees %}
        <h2 class="section">{{ entry.organization.name }}</h2>
        {% if entry.roots is empty %}
            <div class="note">Aucun bloc déclaré pour cette organisation.</div>
        {% else %}
            <div class="card">
                <ul class="tree">
                    {% for root in entry.roots %}
                        {{ tree.branch(root) }}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    {% else %}
        <div class="note">Aucune organisation déclarée.</div>
    {% endfor %}
{% endblock %}
