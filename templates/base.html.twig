<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}MSSub{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
</head>
<body>
<div class="layout">
    <nav class="sidebar no-print">
        <div class="sidebar__brand">
            <span class="sidebar__mark"></span>
            <span>MSSub</span>
        </div>

        <div class="sidebar__section">Référentiel</div>
        <div class="sidebar__nav">
            <a class="sidebar__link {{ nav is defined and nav == 'dashboard' ? 'is-active' }}"
               href="{{ path('app_dashboard') }}">Tableau de bord</a>
            <a class="sidebar__link {{ nav is defined and nav == 'subnets' ? 'is-active' }}"
               href="{{ path('app_subnet_index') }}">Plans d'adressage</a>
            <a class="sidebar__link {{ nav is defined and nav == 'search' ? 'is-active' }}"
               href="{{ path('app_search') }}">Rechercher une IP</a>
        </div>

        <div class="sidebar__spacer"></div>

        <div class="sidebar__foot">
            {% if app.user %}
                <span class="sidebar__user">{{ app.user.displayName ?? app.user.userIdentifier }}</span>
                <a class="sidebar__logout" href="{{ path('app_logout') }}">Se déconnecter</a>
            {% endif %}
        </div>
    </nav>

    <main class="content">
        {% block body %}{% endblock %}
    </main>
</div>
</body>
</html>
